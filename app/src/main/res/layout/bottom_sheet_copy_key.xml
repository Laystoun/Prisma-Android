<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Space
        android:id="@+id/space_sheetCopyKey"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_sheetCopyKey">

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp"/>

        <TextView
            android:id="@+id/tv_sheetCopyKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:fontFamily="sans-serif-monospace"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <ImageView
            android:id="@+id/iv_sheetCopyKey"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center_horizontal"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheetCopyKey"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="32dp"
            android:text="Скопировать"
            android:textSize="16.5sp"
            android:gravity="center"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:iconTint="@color/on_primary"
            app:iconPadding="10dp"
            app:backgroundTint="@null"
            android:background="@drawable/bg_button_base" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="64dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>